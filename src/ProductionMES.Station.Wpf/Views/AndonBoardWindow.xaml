<Window x:Class="ProductionMES.Station.Wpf.Views.AndonBoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Andon Board"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="#0B0E13"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded"
        Activated="Window_Activated">
    <!--
      AndonBoardWindow KHÔNG dùng Light theme MaterialDesignInXaml/Themes/AppColors.xaml của phần còn lại
      trong Station.Wpf (xem ADR-007) — màn hình này theo mockup Andon board thực tế riêng (nền tối, màu
      trạng thái động OK/NG/WAITING). Giữ hex cục bộ tại đây, không tham chiếu brush dùng chung cho các màn
      Tổ trưởng. Bảng PLAN/ACTUAL/BALANCE theo mốc giờ (US-09 AC1-AC6) hiển thị ở Row 1 bên dưới.
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Vùng "số liệu chính" (AC5): tên trạm/công đoạn + số lượng đã scan OK — banner KHÔNG được che vùng này. -->
        <Grid Grid.Row="0" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!--
              US-07, chế độ nhập tay/test (quyết định 17/08/2026 — SRS mục 5.1/8.2): banner cảnh báo LUÔN hiển
              thị liên tục (không tự ẩn, không dùng cùng cơ chế auto-close với ScanBanner) khi
              EnableManualScanInput = true, đặt ngay dưới hàng tên trạm/công đoạn, KHÔNG che số liệu chính.
              Khi cờ tắt (mặc định): Visibility=Collapsed, UI y hệt hiện tại.
            -->
            <Border Grid.Row="0" Background="#6B4E00" BorderBrush="#FFC107" BorderThickness="2" CornerRadius="6"
                    Padding="12,6" Margin="0,0,0,12" HorizontalAlignment="Stretch"
                    Visibility="{Binding IsManualScanInputEnabled, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="⚠ ĐANG BẬT CHẾ ĐỘ NHẬP TAY — TEST ONLY (không dùng ở trạm production)"
                           FontSize="20" FontWeight="Bold" Foreground="#FFC107" HorizontalAlignment="Center"/>
            </Border>

            <!-- row-top (mockup 13/08/2026): tên trạm/công đoạn (trái) + đồng hồ DATE/TIME realtime (phải) — không phụ thuộc HasActivePlan. -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding WorkStationName}" FontSize="38" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>

                <!-- Tên công đoạn canh giữa phần không gian còn lại giữa tên trạm (trái) và khối đồng hồ/số liệu (phải) — cùng cỡ chữ với tên trạm theo yêu cầu 17/08. -->
                <TextBlock Grid.Column="1" Text="{Binding StageName}" FontSize="38" FontWeight="Bold" Foreground="#FFAB1F"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                    <!-- Đồng hồ DATE/TIME realtime (mockup) — đặt phía trên khối số liệu ACTUAL/PLAN/BALANCE đã có (US-09), không đổi khối đó. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                        <TextBlock Text="DATE" FontSize="18" FontWeight="Bold" Foreground="#FFAB1F" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding CurrentDateLabel}" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <TextBlock Text="TIME" FontSize="18" FontWeight="Bold" Foreground="#FFAB1F" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding CurrentTimeLabel}" FontSize="28" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- US-09 AC1: 3 giá trị chính (ACTUAL/PLAN/BALANCE) luôn hiển thị ở đây, cập nhật real-time (AC4), độc lập với việc cuộn bảng theo mốc giờ bên dưới. Cỡ chữ giảm nhẹ so với trước để MODEL (row-model bên dưới) là số liệu nổi bật nhất header, đúng thứ tự ưu tiên trong ảnh Andon board gốc. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="ĐÃ SCAN OK" FontSize="16" Foreground="#8D96A8" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding ScannedOkCount}" FontSize="32" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0" Visibility="{Binding HasActivePlan, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="KẾ HOẠCH (PLAN)" FontSize="16" Foreground="#8D96A8" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding PlanCumulative}" FontSize="32" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding HasActivePlan, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="CHÊNH LỆCH (BALANCE)" FontSize="16" Foreground="#8D96A8" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding BalanceLabel}" FontSize="32" FontWeight="Bold" Foreground="{Binding BalanceBrush}" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!--
              row-model (mockup): dòng NỔI BẬT NHẤT của header — giá trị Model to hơn hẳn mọi chữ khác (đúng ảnh
              Andon board gốc, operator cần nhận ra ngay đang sản xuất đúng Model). Layout Grid Auto/* để value
              Model canh giữa phần không gian còn lại, giống CSS gốc (grid-template-columns: auto 1fr;
              .val { justify-self: center }). LOT chuyển sang hàng row-plan bên dưới, cạnh TAKT TIME (theo yêu
              cầu người dùng 17/08) — cùng cỡ chữ với PROD.PLAN/TAKT TIME thay vì chip riêng biệt.
            -->
            <Grid Grid.Row="2" Margin="0,18,0,0" Visibility="{Binding HasActivePlan, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="MODEL:" FontSize="22" FontWeight="Bold" Foreground="#FFAB1F" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Model}" FontSize="50" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Grid>

            <!--
              row-plan (mockup + yêu cầu 17/08): PROD.PLAN + TAKT TIME + LOT cùng 1 cỡ chữ (đồng bộ, Column 0,
              chiếm hết phần rộng còn lại) — ô PER (tên nhân viên vận hành) đặt ở Column 1 (Auto), neo sát mép
              phải ngoài cùng của hàng, tách biệt khỏi cụm số liệu bên trái.
            -->
            <Grid Grid.Row="3" Margin="0,14,0,0" Visibility="{Binding HasActivePlan, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="PROD.PLAN:" FontSize="22" FontWeight="Bold" Foreground="#FFAB1F" Margin="0,0,8,0" VerticalAlignment="Bottom"/>
                    <TextBlock Text="{Binding PlannedQuantity}" FontSize="28" FontWeight="Bold" Foreground="White" VerticalAlignment="Bottom"/>
                    <TextBlock Text="pcs" FontSize="18" Foreground="#8D96A8" Margin="4,0,40,0" VerticalAlignment="Bottom"/>
                    <TextBlock Text="TAKT TIME:" FontSize="22" FontWeight="Bold" Foreground="#FFAB1F" Margin="0,0,8,0" VerticalAlignment="Bottom"/>
                    <TextBlock Text="{Binding TaktTimeLabel}" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,0,40,0" VerticalAlignment="Bottom"/>
                    <TextBlock Text="LOT:" FontSize="22" FontWeight="Bold" Foreground="#FFAB1F" Margin="0,0,8,0" VerticalAlignment="Bottom"/>
                    <TextBlock Text="{Binding Lot}" FontSize="28" FontWeight="Bold" Foreground="White" VerticalAlignment="Bottom"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#1A1E27" BorderBrush="#2A3040" BorderThickness="1" CornerRadius="6"
                        Padding="14,6" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding OperatorNamesLabel}" FontSize="22" FontWeight="Bold" Foreground="White"/>
                </Border>
            </Grid>

            <!-- row-shift (mockup): STARTING TIME. -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0"
                        Visibility="{Binding HasActivePlan, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="STARTING TIME:" FontSize="22" FontWeight="Bold" Foreground="#FFAB1F" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding StartingTimeLabel}" FontSize="22" FontWeight="Bold" Foreground="White"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <!-- US-09 AC1/AC5/AC6: bảng PLAN/ACTUAL/BALANCE theo mốc giờ + ô NG/%NG gộp — chỉ hiển thị khi trạm đang có kế hoạch active. -->
            <Grid Margin="24" Visibility="{Binding HasActivePlan, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="240"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="#2A3040" BorderThickness="1" Margin="0,0,16,0">
                    <DockPanel LastChildFill="True">
                        <Grid DockPanel.Dock="Top" Background="#151922">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TIME" FontSize="19" FontWeight="Bold" Foreground="#FFAB1F" Padding="12,10" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="PLAN" FontSize="19" FontWeight="Bold" Foreground="#FFAB1F" Padding="12,10" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="ACTUAL" FontSize="19" FontWeight="Bold" Foreground="#FFAB1F" Padding="12,10" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="BALANCE" FontSize="19" FontWeight="Bold" Foreground="#FFAB1F" Padding="12,10" HorizontalAlignment="Center"/>
                        </Grid>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <!-- Dòng "hiện tại" (US-09 mockup) highlight khác các dòng mốc giờ đã qua. -->
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Background" Value="#22344A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <TextBlock Grid.Column="0" Text="{Binding TimeLabel}" FontSize="24" FontWeight="Bold" Foreground="White" Padding="12,8" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding PlanCumulative}" FontSize="24" Foreground="White" Padding="12,8" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ActualCumulative}" FontSize="24" Foreground="White" Padding="12,8" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding BalanceLabel}" FontSize="24" FontWeight="Bold" Foreground="{Binding BalanceBrush}" Padding="12,8" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- 1 ô gộp duy nhất cho cả bảng (không tách theo mốc giờ) — quyết định layout 13/08/2026. -->
                <Border Grid.Column="1" BorderBrush="#2A3040" BorderThickness="1">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="NG / %NG" FontSize="19" FontWeight="Bold" Foreground="#8D96A8" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                        <TextBlock Text="{Binding NgSummaryLabel}" FontSize="34" FontWeight="Bold" Foreground="#E53935" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="Chưa có kế hoạch sản xuất nào đang chạy tại công đoạn này (hoặc đang tải dữ liệu)."
                       Foreground="#5C6577" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="480" TextAlignment="Center"
                       Visibility="{Binding NoActivePlan, Converter={StaticResource BoolToVisibility}}"/>

            <!-- Banner kết quả scan (US-07 AC3/AC4/AC5): góc trên-phải, không đè lên Row 0 (tên trạm/công đoạn/số lượng). -->
            <Border x:Name="ScanBanner"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="24"
                    Background="{Binding BannerBackground}" BorderBrush="{Binding BannerBorderBrush}" BorderThickness="2"
                    CornerRadius="10" Padding="24" MinWidth="360" MaxWidth="480"
                    Visibility="{Binding IsBannerVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding BannerTitle}" FontSize="28" FontWeight="Bold" Foreground="{Binding BannerForeground}"/>

                    <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="NAMESHEET" FontSize="15" Foreground="{Binding BannerForeground}" Opacity="0.7"/>
                        <TextBlock Text="{Binding BannerTagCode}" FontSize="22" FontWeight="SemiBold" Foreground="{Binding BannerForeground}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="MESSAGE" FontSize="15" Foreground="{Binding BannerForeground}" Opacity="0.7"/>
                        <TextBlock Text="{Binding BannerMessage}" FontSize="18" Foreground="{Binding BannerForeground}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Style tường minh (không dùng MaterialDesign implicit style — Application.Resources áp global cho mọi Window, nhưng AC4 cần nút luôn đọc rõ trên nền banner màu động, không phụ thuộc Light theme). -->
                    <Button Content="ĐÃ ĐỌC, ĐÓNG" Margin="0,18,0,0" Padding="16,10" HorizontalAlignment="Right"
                            Background="White" Foreground="#1B1B1B" BorderBrush="White" FontWeight="Bold"
                            Command="{Binding AcknowledgeBannerCommand}" Click="AcknowledgeButton_Click"
                            Visibility="{Binding RequiresAcknowledgement, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>

            <!--
              US-07, khu vực nhập tay/test (quyết định 17/08/2026 — SRS mục 5.1/8.2): chỉ hiển thị khi
              EnableManualScanInput = true, đặt góc dưới-trái, không che nội dung trung tâm hay ScanBanner
              (góc trên-phải). Enter hoặc bấm "Gửi" đều gọi SubmitManualScanCommand → HandleScanAsync, dùng
              chung luồng banner OK/NG/Waiting đã có, không xử lý kết quả riêng. Độc lập với ScanInputBox ẩn
              (máy quét thật) — không thay đổi hành vi của ô đó.
            -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24"
                    Background="#1A1E27" BorderBrush="#FFC107" BorderThickness="1.5" CornerRadius="8" Padding="16"
                    Visibility="{Binding IsManualScanInputEnabled, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Nhập mã tem (test)" FontSize="16" Foreground="#FFC107" Margin="0,0,0,4"/>
                        <TextBox x:Name="ManualScanInputBox" Width="220" FontSize="20" Padding="6"
                                 Text="{Binding ManualScanInputText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="ManualScanInputBox_KeyDown"/>
                    </StackPanel>
                    <Button Content="GỬI" VerticalAlignment="Bottom" Padding="16,8"
                            Background="#FFC107" Foreground="#1B1B1B" BorderBrush="#FFC107" FontWeight="Bold"
                            Command="{Binding SubmitManualScanCommand}" Click="ManualScanSubmitButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Margin="24" Foreground="#5C6577" FontSize="16"
                    Text="Esc: chuyển sang Main Screen (chế độ Tổ trưởng) · Alt+Tab: hành vi Windows chuẩn"/>

        <!--
          Ô ẩn luôn giữ focus để bắt input máy scan HID (keyboard-wedge, Zebra DS2208): ký tự tem gõ vào tự
          tích lũy như TextBox bình thường, Enter kết thúc 1 lượt scan (ScanInputBox_KeyDown). Độc lập với
          Window_PreviewKeyDown (chỉ xử lý Esc) — không "nuốt" phím Esc vì handler này chỉ bắt Enter.
        -->
        <TextBox x:Name="ScanInputBox" Width="1" Height="1" Opacity="0" IsTabStop="False"
                 CaretBrush="Transparent" BorderThickness="0" Background="Transparent"
                 KeyDown="ScanInputBox_KeyDown" LostFocus="ScanInputBox_LostFocus"/>
    </Grid>
</Window>
