<Page x:Class="ProductionMES.Station.Wpf.Views.Pages.PlanSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="clr-namespace:ProductionMES.Station.Wpf.Converters"
      Title="Cài đặt kế hoạch sản xuất"
      Background="#161B23"
      Loaded="Page_Loaded">
    <Page.Resources>
        <converters:LineIdToNameConverter x:Key="LineIdToNameConverter"/>
    </Page.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="← Trang chủ" Click="HomeButton_Click" Margin="0,0,12,0"/>
                <TextBlock Text="Cài đặt kế hoạch sản xuất" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="+ Tạo kế hoạch mới" Command="{Binding NewCommand}"/>
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Content="Cài đặt kế hoạch" Margin="0,0,8,0" IsEnabled="False"/>
            <Button Content="Chọn kế hoạch" Click="PlanSelectionButton_Click" Margin="0,0,8,0"/>
            <Button Content="Trình tự công đoạn (Line)" Click="LineStageSequenceButton_Click"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="#E8A23D" Margin="16,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan, Mode=TwoWay}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Khách hàng" Binding="{Binding Customer}"/>
                    <DataGridTextColumn Header="Model" Binding="{Binding Model}"/>
                    <DataGridTextColumn Header="Lot" Binding="{Binding Lot}"/>
                    <DataGridTextColumn Header="Rev" Binding="{Binding Revision}"/>
                    <DataGridTemplateColumn Header="Line">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Margin="4,0">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LineIdToNameConverter}">
                                            <Binding Path="LineId"/>
                                            <Binding Path="DataContext.AllLines" RelativeSource="{RelativeSource AncestorType=Page}"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="SL kế hoạch" Binding="{Binding PlannedQuantity}"/>
                    <DataGridTextColumn Header="Takt (m:ss)" Binding="{Binding TaktTimeDisplay}"/>
                    <DataGridTextColumn Header="SL/giờ" Binding="{Binding StandardQuantityPerHour}"/>
                    <DataGridTextColumn Header="Bắt đầu" Binding="{Binding StartTimeDisplay}"/>
                </DataGrid.Columns>
            </DataGrid>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,20">
                <TextBlock Text="{Binding FormTitle}" FontWeight="Bold" Foreground="White" FontSize="14" Margin="0,0,0,10"/>

                <TextBlock Text="Line áp dụng" Foreground="#8D96A8" FontSize="11"/>
                <ComboBox ItemsSource="{Binding AvailableLines}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedLine}" IsEnabled="{Binding CanEditLine}" Margin="0,2,0,10"/>

                <TextBlock Text="Khách hàng" Foreground="#8D96A8" FontSize="11"/>
                <TextBox Text="{Binding Customer, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

                <TextBlock Text="Model" Foreground="#8D96A8" FontSize="11"/>
                <TextBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

                <TextBlock Text="Lot" Foreground="#8D96A8" FontSize="11"/>
                <TextBox Text="{Binding Lot, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

                <TextBlock Text="Revision (không bắt buộc)" Foreground="#8D96A8" FontSize="11"/>
                <TextBox Text="{Binding Revision, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

                <TextBlock Text="Số lượng kế hoạch" Foreground="#8D96A8" FontSize="11"/>
                <TextBox Text="{Binding PlannedQuantity, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

                <TextBlock Text="Takt time (phút:giây, vd &quot;1:30&quot;)" Foreground="#8D96A8" FontSize="11"/>
                <TextBox x:Name="TaktTimeTextBox" Text="{Binding TaktTimeDisplay, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,2"
                         LostFocus="TaktTimeTextBox_LostFocus"/>
                <TextBlock Text="{Binding StandardQuantityPerHour, StringFormat='≈ {0} sp/giờ'}" Foreground="#F4B55A" Margin="0,0,0,10"/>

                <TextBlock Text="Thời gian bắt đầu (Ngày + Giờ:Phút, 24h)" Foreground="#8D96A8" FontSize="11"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                    <DatePicker SelectedDate="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                    <TextBox x:Name="StartTimeOfDayTextBox" Text="{Binding StartTimeOfDay, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="8,0,0,0"
                             ToolTip="Giờ:Phút, định dạng HH:mm (24h), vd 07:30"
                             LostFocus="StartTimeOfDayTextBox_LostFocus"/>
                </StackPanel>

                <TextBlock Text="Tên nhân viên vận hành (phân tách bằng dấu phẩy)" Foreground="#8D96A8" FontSize="11"/>
                <TextBox Text="{Binding OperatorNames, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,16"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Lưu" Command="{Binding SaveCommand}" Margin="0,0,8,0" Padding="14,6"/>
                    <Button Content="Hủy" Command="{Binding NewCommand}" Padding="14,6"/>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
