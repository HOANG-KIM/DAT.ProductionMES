<Page x:Class="ProductionMES.Station.Wpf.Views.Pages.ReworkUnlockPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Mở khóa rework"
      Background="{DynamicResource MaterialDesignPaper}">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Page.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="← Trang chủ" Click="HomeButton_Click" Margin="0,0,12,0"/>
                <TextBlock Text="Mở khóa rework" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,26,0">
                    <TextBlock Text="TRẠM" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                    <TextBlock Text="{Binding WorkStationName}" FontWeight="Bold" FontSize="14"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="CÔNG ĐOẠN" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                    <TextBlock Text="{Binding StageName}" FontWeight="Bold" FontSize="14"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" MaxWidth="480" HorizontalAlignment="Left">
            <TextBlock Text="Tem sản phẩm bị NG tại công đoạn trên sẽ bị KHÓA — không thể scan lại cho tới khi được mở khóa tại đây. Xác nhận sản phẩm đã được sửa lỗi trước khi mở khóa."
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,18"/>

            <TextBlock Text="Mã tem cần mở khóa" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
            <DockPanel Margin="0,0,0,6">
                <Button Content="Tra cứu lỗi" Command="{Binding LookupCommand}" DockPanel.Dock="Right" Padding="12,6" Margin="8,0,0,0"/>
                <TextBox x:Name="TagCodeTextBox" Text="{Binding TagCode, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8,6" KeyDown="TagCodeTextBox_KeyDown"/>
            </DockPanel>
            <TextBlock Text="Scan/nhập mã tem rồi nhấn Enter (hoặc nút &quot;Tra cứu lỗi&quot;) để xem lỗi NG gần nhất của tem tại công đoạn này."
                       Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <TextBlock Text="{Binding LookupMessage}" Foreground="{StaticResource StatusNgBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                       Visibility="{Binding HasLookupMessage, Converter={StaticResource BoolToVisibility}}"/>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,18"
                    Visibility="{Binding HasLookupResult, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding LockStatusLabel}" Foreground="{Binding LockStatusBrush}" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <StackPanel Visibility="{Binding HasNgHistory, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="LÝ DO LỖI (NG GẦN NHẤT)" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                        <TextBlock Text="{Binding NgRejectionReason}" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,26,0">
                                <TextBlock Text="NGƯỜI XÁC NHẬN NG" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                <TextBlock Text="{Binding NgConfirmedByUserName}" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,26,0">
                                <TextBlock Text="THỜI ĐIỂM NG" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                <TextBlock Text="{Binding NgScannedAtLocalLabel}" FontSize="13"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="SỐ LẦN NG TẠI CÔNG ĐOẠN NÀY" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                <TextBlock Text="{Binding NgCount}" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Ghi chú (tùy chọn)" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
            <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Padding="8,6" AcceptsReturn="True" Height="70" TextWrapping="Wrap" Margin="0,0,0,18"/>

            <Button Content="Xác nhận mở khóa rework" Command="{Binding UnlockCommand}" Padding="14,8" HorizontalAlignment="Left" FontWeight="Bold"/>

            <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusBrush}" TextWrapping="Wrap" Margin="0,16,0,0" FontSize="13"/>
        </StackPanel>
    </Grid>
</Page>
