<Page x:Class="ProductionMES.Station.Wpf.Views.Pages.PackingModelConfigPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Cấu hình đóng gói theo Model"
      Background="{DynamicResource MaterialDesignPaper}"
      Loaded="Page_Loaded">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Page.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="← Trang chủ" Click="HomeButton_Click" Margin="0,0,12,0"/>
                <TextBlock Text="Cấu hình đóng gói theo Model" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="+ Thêm cấu hình mới" Command="{Binding NewCommand}"/>
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Content="Cài đặt kế hoạch" Click="PlanSettingsButton_Click" Margin="0,0,8,0"/>
            <Button Content="Chọn kế hoạch" Click="PlanSelectionButton_Click" Margin="0,0,8,0"/>
            <Button Content="Trình tự công đoạn (Line)" Click="LineStageSequenceButton_Click" Margin="0,0,8,0"/>
            <Button Content="Cấu hình đóng gói" IsEnabled="False" Margin="0,0,8,0"/>
            <Button Content="Tải lại" Command="{Binding LoadCommand}"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource StatusWarningBrush}" Margin="16,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" ItemsSource="{Binding Configs}" SelectedItem="{Binding SelectedConfig, Mode=TwoWay}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Model" Binding="{Binding Model}"/>
                    <DataGridTextColumn Header="Quy cách (SP/thùng)" Binding="{Binding PackingQuantity}"/>
                    <DataGridTextColumn Header="Khối lượng" Binding="{Binding GrossWeight}"/>
                    <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding PartName}"/>
                    <DataGridTextColumn Header="Nhà sản xuất" Binding="{Binding Manufacturer}"/>
                    <DataGridTextColumn Header="Mẫu tem" Binding="{Binding HasTemplate}"/>
                </DataGrid.Columns>
            </DataGrid>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,20">
                <TextBlock Text="{Binding FormTitle}" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                <TextBlock Text="Model" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                <ComboBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding AvailableModels}"
                          IsEditable="True" IsEnabled="{Binding CanEditModel}" Margin="0,2,0,10"/>

                <TextBlock Text="Quy cách đóng gói (số lượng sản phẩm/thùng)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                <TextBox Text="{Binding PackingQuantityText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

                <TextBlock Text="Khối lượng (không bắt buộc)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                <TextBox Text="{Binding GrossWeightText, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

                <TextBlock Text="Tên sản phẩm" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                <TextBox Text="{Binding PartName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

                <TextBlock Text="Nhà sản xuất (không bắt buộc)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                <TextBox Text="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,16"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="Lưu" Command="{Binding SaveCommand}" Margin="0,0,8,0" Padding="14,6"/>
                    <Button Content="Hủy" Command="{Binding NewCommand}" Padding="14,6"/>
                </StackPanel>

                <TextBlock Text="Mẫu tem in (template .xlsx)" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                <TextBlock Text="{Binding TemplateStatusText}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Visibility="{Binding CanManageTemplate, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="Tải lên mẫu tem…" Click="UploadTemplateButton_Click" Margin="0,0,8,0" Padding="10,4"/>
                    <Button Content="Tải xuống mẫu tem…" Click="DownloadTemplateButton_Click" Padding="10,4"/>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
