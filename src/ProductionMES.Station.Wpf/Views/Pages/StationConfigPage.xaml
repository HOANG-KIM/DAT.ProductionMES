<Page x:Class="ProductionMES.Station.Wpf.Views.Pages.StationConfigPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Cấu hình trạm"
      Background="{DynamicResource MaterialDesignPaper}"
      Loaded="Page_Loaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="← Trang chủ" Click="HomeButton_Click" Margin="0,0,12,0"/>
                <TextBlock Text="Cấu hình trạm" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding StatusMessage}"
                       Foreground="{StaticResource StatusWarningBrush}" VerticalAlignment="Center"/>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="480" HorizontalAlignment="Left">
                <TextBlock Text="Trạm làm việc" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                <ComboBox ItemsSource="{Binding AllWorkStations}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedWorkStation}" Margin="0,2,0,10"/>

                <TextBlock Text="Tên trạm (suy ra tự động)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                <TextBox Text="{Binding WorkStationName, Mode=OneWay}" IsReadOnly="True" Margin="0,2,0,10"/>

                <TextBlock Text="Line (suy ra tự động)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                <TextBox Text="{Binding LineName, Mode=OneWay}" IsReadOnly="True" Margin="0,2,0,10"/>

                <TextBlock Text="Công đoạn (suy ra tự động)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                <TextBox Text="{Binding StageName, Mode=OneWay}" IsReadOnly="True" Margin="0,2,0,10"/>

                <!-- US-25 (sửa lỗi 24/08/2026): suy ra tự động từ Stage.IsPackingStage của công đoạn vừa chọn ở trên — không cho tick tay, tránh lệch với cấu hình thật trên server. -->
                <CheckBox Content="Là công đoạn Đóng thùng (suy ra tự động)" IsChecked="{Binding IsPackingStage, Mode=OneWay}"
                          IsHitTestVisible="False" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,16"/>

                <TextBlock Text="Thời gian chờ Arduino (giây)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                <TextBox Text="{Binding ArduinoTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

                <TextBlock Text="Thời gian chờ chế độ Scan NG (giây)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                <TextBox Text="{Binding NgModeTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

                <TextBlock Text="Chu kỳ làm mới Andon Board (giây)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                <TextBox Text="{Binding AndonBoardRefreshIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

                <TextBlock Text="Thời gian timeout không hoạt động của phiên Tổ trưởng (giây)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                <TextBox Text="{Binding SupervisorSessionIdleTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,10"/>

                <CheckBox Content="Bật chế độ nhập tay/test (KHÔNG bật ở trạm production)" IsChecked="{Binding EnableManualScanInput}"
                          Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,20"/>

                <Button Content="Lưu" Command="{Binding SaveCommand}" HorizontalAlignment="Left" Padding="14,6"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
