<Page x:Class="ProductionMES.Station.Wpf.Views.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Trang chủ"
      Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,28">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <StackPanel Margin="0,0,26,0">
                        <TextBlock Text="TRẠM" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                        <TextBlock Text="{Binding WorkStationName}" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,26,0">
                        <TextBlock Text="LINE" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                        <TextBlock Text="{Binding LineName}" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="CÔNG ĐOẠN" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                        <TextBlock Text="{Binding StageName}" FontWeight="Bold" FontSize="14"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" x:Name="StationConfigTile" Content="🔧" FontSize="16" Padding="10,6"
                        VerticalAlignment="Center" ToolTip="Cấu hình trạm — chọn trạm làm việc, chỉnh timeout Arduino/Scan NG, chu kỳ làm mới Andon Board…"
                        Click="StationConfigTile_Click"/>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1" Columns="5" Rows="1">
            <Button x:Name="PlanSettingsTile" Height="Auto" Margin="0,0,7,0" Padding="18" HorizontalContentAlignment="Left" Click="PlanSettingsTile_Click">
                <StackPanel>
                    <TextBlock Text="⚙  Cài đặt kế hoạch sản xuất" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="Tạo/sửa kế hoạch: Khách hàng, Model, Lot, số lượng, takt time…"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11"/>
                </StackPanel>
            </Button>
            <Button x:Name="PlanSelectionTile" Height="Auto" Margin="7,0,7,0" Padding="18" HorizontalContentAlignment="Left" Click="PlanSelectionTile_Click">
                <StackPanel>
                    <TextBlock Text="📋  Chọn kế hoạch" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="Áp dụng / tạm dừng / đóng kế hoạch cho từng công đoạn của Line"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11"/>
                </StackPanel>
            </Button>
            <Button x:Name="LineStageSequenceTile" Height="Auto" Margin="7,0,7,0" Padding="18" HorizontalContentAlignment="Left" Click="LineStageSequenceTile_Click">
                <StackPanel>
                    <TextBlock Text="🔗  Trình tự công đoạn của Line" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="Thêm/bớt/sắp xếp công đoạn cho Line — dùng chung mọi kế hoạch chạy trên Line đó"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11"/>
                </StackPanel>
            </Button>
            <Button x:Name="ReworkUnlockTile" Height="Auto" Margin="7,0,7,0" Padding="18" HorizontalContentAlignment="Left" Click="ReworkUnlockTile_Click">
                <StackPanel>
                    <TextBlock Text="🔓  Mở khóa rework" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="Mở khóa cho tem bị NG sau khi xác nhận đã sửa lỗi, để công nhân scan lại"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11"/>
                </StackPanel>
            </Button>
            <Button x:Name="PackingModelConfigTile" Height="Auto" Margin="7,0,0,0" Padding="18" HorizontalContentAlignment="Left" Click="PackingModelConfigTile_Click">
                <StackPanel>
                    <TextBlock Text="📦  Cấu hình đóng gói" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Text="Quy cách đóng gói, khối lượng, tên sản phẩm, nhà sản xuất và mẫu tem in theo từng Model"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11"/>
                </StackPanel>
            </Button>
        </UniformGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
            <Button x:Name="BackToAndonButton" Content="◧ Quay lại Andon Board (Alt+Tab)"
                    Height="Auto" Padding="16,9" Click="BackToAndonButton_Click"/>
            <Button x:Name="ExitApplicationButton" Content="🚪 Thoát ứng dụng"
                    Height="Auto" Padding="16,9" Margin="12,0,0,0"
                    Background="{StaticResource StatusNgBrush}" Foreground="White" BorderBrush="{StaticResource StatusNgBrush}"
                    Click="ExitApplicationButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
