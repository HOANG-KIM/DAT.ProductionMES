<!--
  Quy ước màu dùng chung cho toàn bộ Station.Wpf.
  Không hard-code mã hex trong Page/Window — luôn tham chiếu StaticResource các brush bên dưới,
  để đổi màu hệ thống chỉ cần sửa 1 chỗ và giữ đồng bộ giữa các màn hình.

  Màu nền/chữ mặc định (MaterialDesignPaper, MaterialDesignBody...) lấy từ theme MaterialDesignInXaml
  khai báo tại App.xaml — file này chỉ bổ sung các brush ngữ nghĩa riêng của nghiệp vụ MES.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Chữ phụ: nhãn field, tiêu đề cột nhỏ — vẫn cần đọc rõ -->
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4B5563"/>
    <!-- Chữ mờ: ghi chú/hint ít quan trọng hơn -->
    <SolidColorBrush x:Key="TextMutedBrush" Color="#9CA3AF"/>

    <!-- Nền khối/card nổi trên nền trang (vd khối thông tin trạm ở HomePage) -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#E0E0E0"/>

    <!-- Màu trạng thái nghiệp vụ — dùng thống nhất cho mọi nơi hiển thị kết quả scan/trạng thái kế hoạch -->
    <SolidColorBrush x:Key="StatusOkBrush" Color="#2E7D32"/>
    <SolidColorBrush x:Key="StatusNgBrush" Color="#C62828"/>
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#EF6C00"/>

</ResourceDictionary>
